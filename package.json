{
  "name": "skills-wizard",
  "version": "0.1.0",
  "description": "Compose AGENTS.md from blocks and install it into coding agents",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/feRpicoral/skills-wizard.git"
  },
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=24"
  },
  "bin": "./dist/cli.js",
  "files": [
    "dist",
    "blocks",
    "presets",
    "skills",
    "!skills/*/evals",
    "catalog.yaml",
    "mcp",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "skills-wizard": "node src/cli.ts",
    "lint": "eslint .",
    "typecheck": "tsc",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "node --test 'src/**/*.test.ts'",
    "format": "prettier --write .",
    "readme:screenshot": "node scripts/readme-screenshot.ts",
    "postinstall": "husky",
    "prepack": "pinst --disable && yarn build",
    "postpack": "pinst --enable"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --config eslint.config.mjs --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "detect-indent": "7.0.2",
    "detect-newline": "4.0.1",
    "dot-prop": "10.2.0",
    "jsonc-parser": "3.3.1",
    "smol-toml": "^1.9.1",
    "which": "7.0.0",
    "write-file-atomic": "8.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@types/which": "3.0.4",
    "@types/write-file-atomic": "4.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pinst": "^3",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
